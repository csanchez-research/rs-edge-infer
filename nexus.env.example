# =============================================================================
#  nexus.env.example  -  Nexus pip source (primary) + fallback
# -----------------------------------------------------------------------------
#  Copy to nexus.env and set your Nexus host. nexus.env is gitignored. Read by:
#    - host/run_experiment.sh (sources it, lean image)
#    - docker compose --env-file nexus.env build
#    - the VS Code devcontainer, if you launch VS Code with these in the env:
#         set -a; source nexus.env; set +a; code .
#
#  PIP_INDEX_URL       -> PRIMARY = your Nexus (serves + caches).
#  PIP_EXTRA_INDEX_URL -> FALLBACK(s), space-separated. Anything Nexus lacks
#                         (e.g. PyTorch +cpu wheels) still resolves from here.
#  PIP_TRUSTED_HOST    -> your Nexus host (plain HTTP needs this).
#
#  "Nexus first, fall back for MISSING packages". pip does NOT auto-fall-back if
#  the Nexus host is unreachable (it errors) - a pip limitation. To route
#  PyTorch via Nexus too, add a pytorch proxy repo and point PIP_INDEX_URL at a
#  Nexus GROUP repo that aggregates pypi-proxy + pytorch-proxy.
# =============================================================================
PIP_INDEX_URL=http://<NEXUS_IP>:8094/repository/pypi-proxy/simple
PIP_EXTRA_INDEX_URL=https://pypi.org/simple https://download.pytorch.org/whl/cpu
PIP_TRUSTED_HOST=<NEXUS_IP>